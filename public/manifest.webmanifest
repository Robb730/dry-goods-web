{
  "name": "Abella's Dry Goods",
  "short_name": "Dry Goods",
  "description": "Order management for Abella's Dry Goods — orders, preparing, delivery, and customers.",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#f0f4ff",
  "theme_color": "#2563eb",
  "start_url": "/?source=pwa",
  "scope": "/",
  "lang": "en",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    { "name": "New Order", "url": "/orders/new", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Preparing", "url": "/preparing", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Delivery", "url": "/delivery", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
